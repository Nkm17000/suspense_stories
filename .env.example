# =========================
# MongoDB
# =========================
MONGODB_URI=
MONGODB_DATABASE=storydb
MONGODB_COLLECTION=longstory
STORY_ID=

# =========================
# Cloudflare Workers AI
# =========================
# Configure multiple Cloudflare accounts in priority order.
# Account 1 is used until the next image would exceed the 8,500-neuron
# per-account UTC-day routing threshold, then account 2, then account 3.
CLOUDFLARE_ACCOUNT_COUNT=3
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_API_TOKEN_3=

# Legacy single-account variables are still supported:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

CLOUDFLARE_ACCOUNT_SWITCH_THRESHOLD=8500
CLOUDFLARE_USAGE_COLLECTION=cloudflare_daily_usage
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=1
CLOUDFLARE_IMAGE_RETRIES=2
CLOUDFLARE_IMAGE_TIMEOUT=120

# Local neuron usage ledger / routing threshold
CLOUDFLARE_BASE_NEURONS_PER_TILE=4.8
CLOUDFLARE_NEURONS_PER_STEP=9.6

# =========================
# Pollinations fallback
# =========================
POLLINATIONS_IMAGE_RETRIES=3
POLLINATIONS_IMAGE_TIMEOUT=30

# =========================
# Facebook Page
# =========================
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v24.0
FB_VIDEO_PATH=final_video.mp4
FB_POST_TITLE=Smart Learning Lab - Suspense Story
FB_POST_DESCRIPTION=Watch this suspense story from Smart Learning Lab.

# =========================
# Instagram Professional Account
# =========================
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# =========================
# Video / branding
# =========================
CTA_URL=https://www.facebook.com/thesmartlearninglab
LOGO_PATH=logo.png
LOGO_SIZE=125
LOGO_MARGIN=18
END_CARD_DURATION=5
TITLE_CARD_DURATION=3
TITLE_TEMPLATE_PATH=assets/title_page_template.png
